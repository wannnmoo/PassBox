{
  "name": "passbox",
  "version": "1.3.0",
  "description": "本地密码管理器",
  "author": "PassBox",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "icon:preview": "node scripts/icon-preview.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test:logic": "electron scripts/logic-test.js",
    "test:smoke": "electron scripts/smoke-test.js",
    "test": "npm run typecheck && npm run build && electron scripts/logic-test.js && electron scripts/smoke-test.js",
    "pack": "set \"CSC_IDENTITY_AUTO_DISCOVERY=false\" && npm run icon && electron-vite build && electron-builder --dir",
    "dist": "set \"CSC_IDENTITY_AUTO_DISCOVERY=false\" && npm run icon && electron-vite build && electron-builder",
    "dist:installer": "set \"CSC_IDENTITY_AUTO_DISCOVERY=false\" && npm run icon && electron-vite build && electron-builder --win nsis",
    "dist:portable": "set \"CSC_IDENTITY_AUTO_DISCOVERY=false\" && npm run icon && electron-vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.passbox.app",
    "productName": "PassBox",
    "icon": "resources/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "afterPack": "./scripts/after-pack.js",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PassBox",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "lucide-react": "^1.17.0"
  }
}
